# 运行数据（本机的待办、归档、令牌、日志，不进仓库）
data/
archive/
logs/
*.log
*.db
*.db-shm
*.db-wal

# 打包产物（由 scripts/build-dist.mjs 生成，另行发布在 Releases）
dist/
build/out/
build/portable/
build/payload.zip
build/bundle.zip
build/*.exe
build/app.ico
build/src/**/*.zip
build/src/launcher-restored/

# 临时文件
.tmp-*/
_asar*/
*.bak
tmp-*.mjs
